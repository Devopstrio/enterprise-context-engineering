            subgraph "context-platform Namespace"
                Pod1["API Pod (Replica 1)"]:::k8s
                Pod2["API Pod (Replica 2)"]:::k8s
                Pod3["API Pod (Replica 3)"]:::k8s
            end
            
            HPA["Horizontal Pod Autoscaler"]:::k8s
        end
        
        Redis[("ElastiCache Redis<br/>(Multi-AZ)")]:::aws
        Dynamo[("DynamoDB<br/>(On-Demand)")]:::aws
        CloudWatch["CloudWatch Logs"]:::aws
    end

    User -->|HTTPS| ALB
    ALB --> Ingress
    Ingress --> Pod1 & Pod2 & Pod3
    
    Pod1 & Pod2 & Pod3 -->|Read/Write Context| Redis
    Pod1 & Pod2 & Pod3 -->|Read/Write History| Dynamo
    Pod1 & Pod2 & Pod3 -->|Export Audit Events| CloudWatch
    
